{
  "name": "rebaroptima",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "dev:backend": "npm run start:dev --workspace=backend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "start": "node backend/dist/main.js",
    "start:backend": "node backend/dist/main.js",
    "start:prod": "node backend/dist/main.js",
    "lint": "npm run lint --workspace=frontend",
    "test:backend": "npm run test --workspace=backend"
  },
  "dependencies": {
    "@mlightcad/mtext-parser": "^1.5.5",
    "@mlightcad/mtext-renderer": "0.13.4",
    "@velipso/polybool": "^1.1.1",
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^1.25.0",
    "three": "^0.172.0"
  },
  "overrides": {
    "@mlightcad/mtext-renderer": "0.13.4"
  },
  "allowScripts": {
    "lucide-react@1.25.0": true
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "1.1.5",
    "@rolldown/binding-darwin-x64": "1.1.5",
    "@rolldown/binding-linux-arm64-gnu": "1.1.5",
    "@rolldown/binding-linux-arm64-musl": "1.1.5",
    "@rolldown/binding-linux-x64-gnu": "1.1.5",
    "@rolldown/binding-linux-x64-musl": "1.1.5",
    "@rolldown/binding-win32-x64-msvc": "1.1.5"
  }
}
